# ── Stooorna Ai (copy to .env and fill) ───────────────────

# openai | gemini | ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Embeddings: openai | ollama | huggingface
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Vector store: chroma | pinecone | memory
VECTOR_STORE=chroma
# CHROMA_PATH=./data/chroma

# Pinecone (optional)
PINECONE_API_KEY=
PINECONE_INDEX=stooorna-ai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Hugging Face (optional)
HF_TOKEN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://stooorna.com

DEBUG=false
